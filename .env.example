# OctoApp Companion Environment Configuration

# REQUIRED: Replace with your actual Moonraker instance URL
# Examples:
#   - Same machine: http://host.docker.internal:7125
#   - Different machine: http://192.168.1.100:7125
#   - Custom port: http://192.168.1.100:8125
MOONRAKER_URL=http://192.168.1.100:7125

# Optional: Moonraker port (extracted from URL if not specified)
MOONRAKER_PORT=7125